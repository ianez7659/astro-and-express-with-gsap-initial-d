---
import EditProfileForm from "@/components/EditProfileForm.astro";
import ProtectedPageLayout from "@/layout/protectedPageLayout.astro";
import BackgroundContainer from "../components/common/background-container.astro";
import "../scripts/page-anim.ts";
import "../scripts/profile-handler.ts";
---

<ProtectedPageLayout title="User Profile">
  <BackgroundContainer
    color="rgba(115, 115, 115, 1)"
    imagePath="/bg-profile.png"
    classNameImage="left-5"
    styleNameImage="background-size: 100%; background-position: left 75%;"
    bgLayerAnimDuration=""
    bgImageAnimType="slide-top-right"
    bgImageAnimDelay="0.2"
    showLogo={false}
  >
    <EditProfileForm />
  </BackgroundContainer>
</ProtectedPageLayout>
